rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['owner', 'staff'];
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /whatsappConversations/{conversationId} {
      allow read, write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read, write: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /assessments/{assessmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read, write: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
